# ============================================================
# Backend Environment Variables — COPY to .env and fill in
# ============================================================

# ── Google Gemini AI ──────────────────────────────────────────
# Required for resume analysis and candidate AI chat
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Brevo (Transactional Email Service) ───────────────────────
# Required for sending candidate notifications & invite emails
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email@example.com
BREVO_SENDER_NAME=VTAB Square Recruitment

# ── Supabase (Database & Authentication) ──────────────────────
# Required for database records and staff authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_or_service_role_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Company & Recruiter Defaults ──────────────────────────────
# Recruiter inbox and interviewer defaults
COMPANY_EMAIL=vitabsquare@gmail.com
INTERVIEW_MANAGER_EMAIL=vitabsquare@gmail.com

# ── Frontend & CORS Configuration ─────────────────────────────
# Base URL of frontend and allowed origins for CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Google OAuth & Calendar / Gmail API ────────────────────────
# File paths for local development or base64 token for cloud hosting
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
# Optional base64-encoded token for cloud deployment (e.g. Render)
# GOOGLE_TOKEN_JSON=your_base64_encoded_token_json_here

# ── Observability & Monitoring (Optional) ─────────────────────
# Optional Sentry error monitoring (leave unset if using standard Render/stdout logs)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# ENVIRONMENT=production

